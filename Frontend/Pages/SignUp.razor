@page "/signup"
@using Frontend.Models
@using Frontend.Services

@inject HttpClient Http
@inject NavigationManager NavigationManager

@inject CustomAuthenticationStateProvider AuthStateProvider

<h3>Sign Up</h3>

<div class="row">
    <div class="col-md-4">
        <form @onsubmit="@SignUpUser" Model="@signUpDTO">
            <div class="form-group">
                <label for="Username" class="control-label">Username: </label>
                <input id="Username" class="form-control" @bind="signUpDTO.Username" />
            </div>
            <div class="form-group">
                <label for="Email" class="control-label">Email: </label>
                <input id="Email" class="form-control" @bind="signUpDTO.Email" />
            </div>
            <div class="form-group">
                <label for="Password" class="control-label">Password: </label>
                <input type="password" id="Password" class="form-control" @bind="signUpDTO.Password" />
            </div>
            <div class="form-group">
                <label for="Password_confirm" class="control-label">Confirm Password: </label>
                <input type="password" id="Password_confirm" class="form-control" @bind="confPass" />
            </div>
            <button type="submit">Go !</button>
            <span>
                @message
            </span>
        </form>
    </div>
</div>

@code {

    private SignUpDTO signUpDTO = new SignUpDTO();
    private string message = "";
    private string confPass = "";

    private async Task SignUpUser()
    {
        if (!confPass.Equals(signUpDTO.Password))
        {
            message = "Passwords don't match!";
            return;
        }

        try
        {


            var result = await Http.PostAsJsonAsync("/authenticate/signup", signUpDTO);

            if (result.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                message = await result.Content.ReadAsStringAsync();
            }
            
        }
        catch (HttpRequestException httpEx) // Manejo básico de errores HTTP
        {
            message = $"Connection Error: {httpEx.Message}";
        }
        catch (Exception E)
        {
            message = $"Unknown Error: {E.Message}";
        }
    }
}


