@page "/login"
@using Frontend.Models
@using Frontend.Services
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject CustomAuthenticationStateProvider AuthStateProvider

<h3>Log In</h3>

<div class="row">
    <div class="col-md-4">
        <form @onsubmit="@LogInUser" Model="@loginDTO">
            <div class="form-group">
                <label for="Email" class="control-label">Email: </label>
                <input id="Email" class="form-control" @bind="loginDTO.Email"/>
            </div>
            <div class="form-group">
                <label for="Password" class="control-label">Password: </label>
                <input type="password" id="Password" class="form-control" @bind="loginDTO.Password" />
            </div>
            <button type="submit">Go !</button>
            <span>
                @message
            </span>
        </form>
    </div>
</div>

@code {

    private LoginDTO loginDTO = new LoginDTO();
    private bool isLoading = false;
    private string message = ""; 

    private async Task LogInUser()
    {

        try
        {

            var result = await Http.PostAsJsonAsync("/authenticate/login", loginDTO);
            var messageResult = await result.Content.ReadAsStringAsync();
            if (result.IsSuccessStatusCode)
            {

                await AuthStateProvider.MarkUserAsAuthenticated(messageResult);

               
                NavigationManager.NavigateTo("/");
            }
            else
            {
               
                message = "Login fallido: Token no recibido: " + messageResult; 
            }

        }
        catch (HttpRequestException httpEx) 
        {
            message = $"Error de conexión: {httpEx.Message}";

        }
        catch (Exception ex)
        {
            
            message = $"Ocurrió un error: {ex.Message}";
            Console.WriteLine($"Error durante el login: {ex}"); 
        }
        finally
        {
            isLoading = false;
        }

    }
}
