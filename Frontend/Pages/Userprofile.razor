@using Frontend.Models
@page "/userprofile/{UserId:int}"
@inject HttpClient Http

@if (user != null)
{
    <img src="@($"https://localhost:7153/images/Users/{@user.Id}.jpg")" alt="Foto de perfil" width="100" height="100" />
    <h3>@user.Name @user.Lastname</h3>
    <p><h4>@user.User1</h4></p>
    <p><h4>@user.Email</h4></p>


}
else
{
    <p>Loading profile...</p>
}


@code {
    [Parameter]
    public int UserId { get; set; }

    private UserDTO user;

    protected override async Task OnInitializedAsync()
    {
        user = await Http.GetFromJsonAsync<UserDTO>($"user/{UserId}"); 
 
    }
}

